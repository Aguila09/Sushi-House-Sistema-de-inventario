# Django
SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Mexico_City
DJANGO_PAGE_SIZE=10

# SimpleJWT
SIMPLE_JWT_ACCESS_MINUTES=60
SIMPLE_JWT_REFRESH_DAYS=7

# Database (SQL Server)
DB_ENGINE=mssql
DB_NAME=SushiHouseDB
DB_USER=
DB_PASSWORD=
# Windows local SQL Express example: localhost\SQLEXPRESS
# Remote example: 192.168.1.10
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_DRIVER=ODBC Driver 18 for SQL Server
# Extra params useful for dev; review in production
DB_EXTRA_PARAMS=TrustServerCertificate=yes;

# Backups
BACKUP_SCHEDULE_HOUR=2
BACKUP_SCHEDULE_MINUTE=0
BACKUPS_MAX_FILES=10

# DRF Throttling
DRF_THROTTLE_USER=120/minute
DRF_THROTTLE_ANON=60/minute
DRF_THROTTLE_AUTH=5/minute

# Security in production
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Scheduler control
DISABLE_SCHEDULER=False
