# Producción - variables sugeridas

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-dominio.com,tu-ip
DJANGO_TIME_ZONE=America/Mexico_City
DJANGO_PAGE_SIZE=50
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_SEGURA

# Base de datos (SQL Server)
DB_ENGINE=mssql
DB_NAME=SushiHouse
DB_HOST=sqlserver.tu-dominio.com
DB_PORT=1433
DB_USER=usuario
DB_PASSWORD=contraseña
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=TrustServerCertificate=yes

# CORS/CSRF
CORS_ALLOWED_ORIGINS=https://tu-dominio.com
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com

# JWT
SIMPLE_JWT_ACCESS_MINUTES=60
SIMPLE_JWT_REFRESH_DAYS=7

# Backups
BACKUP_SCHEDULE_HOUR=3
BACKUP_SCHEDULE_MINUTE=0
BACKUPS_MAX_FILES=30

# Throttling DRF
DRF_THROTTLE_USER=1000/day
DRF_THROTTLE_ANON=500/day
DRF_THROTTLE_AUTH=20/min

# Seguridad (producción)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_HSTS_PRELOAD=True

# Logging
DJANGO_LOG_LEVEL=INFO

# Scheduler (0 = habilitado; 1 = deshabilitado)
DISABLE_SCHEDULER=0
